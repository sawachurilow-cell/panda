# --- Подключение к B2B API i-t-p.pro ---
# Домен входа в b2b (без https://). Все запросы идут на https://<домен>/api/2
B2B_DOMAIN=b2b.i-t-p.pro
# Учётные данные одного из аккаунтов. БЕЗ них бэкенд стартует в демо-режиме (mockData).
B2B_LOGIN=
B2B_PASSWORD=
# Идентификатор прайс-листа в именах файлов каталога: catalog_tree_<id>.json / products_<id>.json.
# По докам примеры используют id=9. Оставьте пустым, если файлы без суффикса.
B2B_PRICE_LIST_ID=9
# Склад (логистический центр) по умолчанию для создаваемых заказов. 1 = МСК.
B2B_LOGISTIC_CENTER=1

# --- Розничная наценка (опт → розница) ---
# Процент наценки поверх оптовой цены. Правило доработать в server/pricing.js.
RETAIL_MARKUP_PERCENT=0

# --- Сервер ---
PORT=3000
# В проде за Nginx: HOST=127.0.0.1 (порт не виден снаружи). Локально можно не задавать.
HOST=0.0.0.0

# --- Кэш (мс). Значения подобраны под лимиты API, не занижать бездумно. ---
# Каталог обновляется раз в сутки ночью → тянуть не чаще.
CACHE_CATALOG_MS=86400000
# get_active_products лимит 10/час → минимум ~6 мин между обновлениями цен.
CACHE_PRICES_MS=600000
