# Скопируйте в .env (в .gitignore, в репозиторий не попадёт).
B2B_DOMAIN=b2b.i-t-p.pro
B2B_LOGIN=
B2B_PASSWORD=
B2B_PRICE_LIST_ID=9
B2B_LOGISTIC_CENTER=1
# Розничная наценка, % — правится вручную здесь.
RETAIL_MARKUP_PERCENT=0
# TTL кэша (мс). Не занижать: цены 10/час, каталог 2/час.
CACHE_CATALOG_MS=86400000
CACHE_PRICES_MS=600000
